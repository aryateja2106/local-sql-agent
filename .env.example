# LLM API Configuration
# For LM Studio
LLM_API_URL=http://127.0.0.1:1234

# Prefer the cooler mid-size model. Avoid keeping Qwen3.6 35B resident unless needed.
LLM_MODEL=gemma-4-12b-it-qat

# For Ollama (uncomment to use)
# LLM_API_URL=http://127.0.0.1:11434
# LLM_MODEL=llama3

# Database Configuration
# sales_database.db = original demo
# pipeline_database.db = Southwest DQE Kafka→S3→Glue→Redshift practice tables
DATABASE_PATH=pipeline_database.db

# Agent behavior
SQL_DIALECT=sqlite
SQL_AGENT_DOMAIN=pipeline
SQL_AGENT_FEW_SHOT_PATH=datasets/southwest_pipeline_nl2sql.jsonl

# Thermal tip:
# Load with scripts/cool_load.sh (Gemma 12B, context 4096, parallel 1).
# Run ONE query at a time. When finished: lms unload --all && lms server stop
