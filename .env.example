# LLM API Configuration
# For LM Studio
LLM_API_URL=http://127.0.0.1:1234

# Preferred loaded model ID from LM Studio / Ollama.
# If unset, the agent prefers Qwen3.6 35B, then Gemma 4 12B, then other loaded models.
# LLM_MODEL=qwen3.6-35b-a3b-ud-iq1_m

# For Ollama (uncomment to use)
# LLM_API_URL=http://127.0.0.1:11434
# LLM_MODEL=llama3

# Database Configuration
# sales_database.db = original demo
# pipeline_database.db = Southwest DQE Kafka→S3→Glue→Redshift practice tables
DATABASE_PATH=pipeline_database.db

# Agent behavior
SQL_DIALECT=sqlite
SQL_AGENT_DOMAIN=pipeline
SQL_AGENT_FEW_SHOT_PATH=datasets/southwest_pipeline_nl2sql.jsonl

# Optional: Set to true to enable debug mode
# DEBUG=true
